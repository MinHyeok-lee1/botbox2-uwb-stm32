{
    "version": 3,
    "configurePresets": [
        {
            "name": "default",
            "hidden": true,
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "toolchainFile": "${sourceDir}/cmake/gcc-arm-none-eabi.cmake",
            "cacheVariables": {
            }
        },
        {
            "name": "Debug",
            "inherits": "default",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "Release",
            "inherits": "default",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "Release-rxdiag",
            "inherits": "default",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "PRODUCT_COPY_DELIVERY_ARTIFACTS": "OFF",
                "UWB_RXDIAG_LOG_ENABLE": "ON",
                "UWB_VERBOSE_TAG_DIAG_LOG_ENABLE": "ON"
            }
        },
        {
            "name": "Release-standby",
            "inherits": "default",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "PRODUCT_COPY_DELIVERY_ARTIFACTS": "OFF",
                "PRODUCT_LOW_POWER_MODE": "2",
                "PRODUCT_LOW_POWER_AUTO_ENTRY": "1"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "Debug",
            "configurePreset": "Debug"
        },
        {
            "name": "Release",
            "configurePreset": "Release"
        },
        {
            "name": "Release-rxdiag",
            "configurePreset": "Release-rxdiag"
        },
        {
            "name": "Release-standby",
            "configurePreset": "Release-standby"
        }
    ]
}
